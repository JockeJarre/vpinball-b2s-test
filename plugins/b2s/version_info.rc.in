// Generated from plugins/b2s/version_info.rc.in by CMake: the file properties (Explorer Details tab) of the
// plugin library, stamped with the git revision and the build time so a DLL can be identified on disk. Every
// build of this plugin used to look identical, which made testing 'the latest' a guessing game
#include <winresrc.h>

VS_VERSION_INFO VERSIONINFO
FILEVERSION    0,1,0,0
PRODUCTVERSION 0,1,0,0
FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
FILEFLAGS      0
FILEOS         VOS_NT_WINDOWS32
FILETYPE       VFT_DLL
FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "B2S Pro"
            VALUE "FileDescription",  "B2S Pro backglass renderer plugin"
            VALUE "FileVersion",      "0.1.0 (@B2S_BUILD_ID@)"
            VALUE "InternalName",     "plugin-b2spro"
            VALUE "LegalCopyright",   "https://github.com/KWildman69/B2S-Pro"
            VALUE "OriginalFilename", "plugin-b2spro64.dll"
            VALUE "ProductName",      "B2S Pro"
            VALUE "ProductVersion",   "0.1.0"
            VALUE "PrivateBuild",     "@B2S_BUILD_ID@"
            VALUE "SpecialBuild",     "@B2S_BUILD_ID@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
